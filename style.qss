/* PyGraphy appearance.

   This is the only styling file. appearance.py loads it with load_style.

   palette(window), palette(window-text), palette(button),
   palette(highlight), palette(highlighted-text), and palette(base)
   come from the active palette. On Omarchy, appearance.py fills those
   roles from the active theme. Other Linux desktops keep the
   freedesktop light or dark palette. Windows and macOS use the
   built-in palette and still follow the OS light or dark setting.
   Do not type a hex color here. A hex color would stay the same
   when the theme changes.

   To change a font, edit font-size on QLabel#homeTitle.
   To change spacing, edit padding on the mode buttons or min-height
   on the graph choices. Save the file and start the app again.
   A theme change is picked up while the app is open. load_style in
   appearance.py reads this file again then.
*/

QMainWindow,
QWidget#appShell,
QWidget#workspacePage,
QWidget#dataTableSide,
QWidget#manualPage,
QWidget#serialPage,
QWidget#viewAllPage,
QWidget#graphBoard {
    background-color: palette(window);
    color: palette(window-text);
}

QLabel#homeTitle {
    font-size: 22pt;
    font-weight: 700;
    color: palette(window-text);
}

QLabel#emptyState {
    font-size: 13pt;
    color: palette(window-text);
}

QLabel#sectionLabel {
    font-weight: 600;
    color: palette(window-text);
}

QLabel#pageHint {
    color: palette(window-text);
}

QGroupBox {
    font-weight: 600;
    margin-top: 10px;
    padding: 12px;
    color: palette(window-text);
    background-color: palette(button);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QGroupBox::title {
    color: palette(window-text);
    background-color: palette(button);
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QPushButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 4px;
}

QPushButton:hover {
    background-color: palette(light);
}

QPushButton:pressed {
    background-color: palette(mid);
}

QPushButton:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-color: palette(highlight);
}

QPushButton:disabled {
    color: palette(dark);
}

QPushButton#mode-graph,
QPushButton#mode-manual,
QPushButton#mode-serial,
QPushButton#mode-viewall {
    font-weight: 600;
    padding: 8px 18px;
    min-height: 32px;
}

QPushButton#mode-graph:checked,
QPushButton#mode-manual:checked,
QPushButton#mode-serial:checked,
QPushButton#mode-viewall:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QFrame#viewBubble {
    border: 1px solid palette(mid);
    border-radius: 18px;
    background: palette(window);
}

QWidget#viewAllBar {
    background: palette(window);
}

QPushButton[graphChoice="true"] {
    min-height: 64px;
    padding: 16px;
}

QLineEdit,
QPlainTextEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QComboBox,
QSpinBox {
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QComboBox QAbstractItemView {
    background-color: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QTabBar {
    background: palette(window);
}

QTabBar::tab {
    background: palette(button);
    color: palette(window-text);
    border: 1px solid palette(mid);
    padding: 6px 12px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
    border-color: palette(highlight);
}

QTabWidget::pane {
    background: palette(window);
    border: 1px solid palette(mid);
}

QTabBar#manualTableTabs::tab {
    padding: 6px 14px;
    margin-right: 6px;
    color: palette(window-text);
    background: palette(button);
}

QTabBar#manualTableTabs::tab:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QTableView {
    background-color: palette(base);
    alternate-background-color: palette(alternate-base);
    color: palette(text);
    gridline-color: palette(mid);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QTableView::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QHeaderView::section {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    padding: 4px;
}

QLabel#noticeLabel {
    color: palette(window-text);
    padding: 4px 0;
}

QMenuBar,
QStatusBar {
    background-color: palette(window);
    color: palette(window-text);
}

QMenu {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
}

QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QFrame#graphPanel {
    border: 1px solid palette(mid);
    border-radius: 6px;
    background: palette(window);
}

QFrame#graphPanel[selected="true"] {
    border: 2px solid palette(highlight);
}
