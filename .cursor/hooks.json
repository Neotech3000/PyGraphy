{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": ".cursor/hooks/audit-hook.sh sessionStart" }],
    "sessionEnd": [{ "command": ".cursor/hooks/audit-hook.sh sessionEnd" }],
    "preToolUse": [
      {
        "command": ".cursor/hooks/audit-hook.sh preToolUse",
        "matcher": "Shell|Read|Write|Grep|Delete|Task"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/audit-hook.sh postToolUse",
        "matcher": "Shell|Read|Write|Grep|Delete|Task"
      }
    ],
    "postToolUseFailure": [
      { "command": ".cursor/hooks/audit-hook.sh postToolUseFailure" }
    ],
    "beforeShellExecution": [
      { "command": ".cursor/hooks/audit-hook.sh beforeShellExecution" },
      { "command": "/.local/share/cursor-agent/hooks/guard.sh", "failClosed": true }
    ],
    "afterShellExecution": [
      { "command": ".cursor/hooks/audit-hook.sh afterShellExecution" }
    ],
    "afterFileEdit": [
      { "command": ".cursor/hooks/audit-hook.sh afterFileEdit" }
    ],
    "beforeSubmitPrompt": [
      { "command": ".cursor/hooks/audit-hook.sh beforeSubmitPrompt" }
    ],
    "stop": [{ "command": ".cursor/hooks/audit-hook.sh stop" }]
  }
}
